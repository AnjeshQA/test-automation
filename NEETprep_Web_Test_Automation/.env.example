# Local run settings - copy this file to .env and edit it:
#     cp .env.example .env
# .env is gitignored, so these settings stay on your machine and never affect CI.

# 1 = show the browser window while tests run (headed)
# 0 = headless (default). You can also comment the line out.
HEADED=0

# Pause in milliseconds between browser actions, so you can follow each step.
# Only used when HEADED=1. 0 = full speed.
SLOWMO=500
