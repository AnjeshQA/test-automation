# Framework-level ignores. The main list is in the repo-root .gitignore.
#
# Test reports are NOT committed: every local or CI run (Jenkinsfile, GitHub Actions)
# creates them fresh, and CI publishes them as build artifacts.
# Everything needed to RUN the tests (code, conf.ini, Excel/testdata.xlsx, requirements.txt,
# pytest.ini, features/) stays tracked.

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# IDE / OS
.idea/
.DS_Store

# Generated reports and output
allure-results/
allure-report/
reports/
test-results/
Logs/
*.csv
*.xlxs
